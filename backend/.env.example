# ============================================================
# Van Sales B2B - Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the actual '.env' file to Git!
# ============================================================

# Database Configuration (Neon PostgreSQL or Local PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host-url>/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your_database_password_here

# JWT Authentication (64-character hex key)
JWT_SECRET=your_64_character_hex_secret_key_here
JWT_EXPIRATION_MS=86400000

# Server Port (Default: 8080)
PORT=8080

